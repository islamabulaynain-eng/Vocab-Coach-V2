/**
 * Vocab Recall Coach V2 - Google Sheets Sync Backend
 * Handles GET and POST requests from the HTML app to sync vocabulary data.
 */

const SHEET_NAMES = {
  VOCAB: 'Vocabulary',
  LOG: 'SRS_Log',
  SESSIONS: 'Sessions',
  SETTINGS: 'Settings'
};

/**
 * Handles GET requests (used for initial load / full sync)
 */
function doGet(e) {
  try {
    const action = e.parameter.action || 'getAllWords';
    
    if (action === 'getAllWords') {
      const words = getAllWords();
      return createJsonResponse({ status: 'success', words: words });
    }
    
    return createJsonResponse({ status: 'error', message: 'Unknown GET action' });
  } catch (error) {
    return createJsonResponse({ status: 'error', message: error.message });
  }
}

/**
 * Handles POST requests (used for adding, updating, deleting, and logging)
 */
function doPost(e) {
  try {
    const payload = JSON.parse(e.postData.contents);
    const action = payload.action;
    const data = payload.data;
    
    let result = { status: 'success' };
    
    switch (action) {
      case 'add':
      case 'addWord':
        addWord(data);
        break;
      case 'update':
      case 'updateWord':
        updateWord(data);
        break;
      case 'delete':
      case 'deleteWord':
        deleteWord(data.id);
        break;
      case 'logRating':
        logRating(data);
        break;
      case 'logSession':
        logSession(data);
        break;
      case 'updateSettings':
        updateSettings(data);
        break;
      default:
        result = { status: 'error', message: 'Unknown POST action: ' + action };
    }
    
    return createJsonResponse(result);
  } catch (error) {
    return createJsonResponse({ status: 'error', message: error.message });
  }
}

/* ============================================================
   CORE OPERATIONS
============================================================ */

function getAllWords() {
  const sheet = getSheet(SHEET_NAMES.VOCAB);
  const data = sheet.getDataRange().getValues();
  if (data.length <= 1) return []; // Only headers or empty
  
  const headers = data[0];
  const words = [];
  
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    if (!row[0]) continue; // Skip empty rows
    words.push(rowToWord(row));
  }
  return words;
}

function addWord(wordData) {
  const sheet = getSheet(SHEET_NAMES.VOCAB);
  const row = wordToRow(wordData);
  sheet.appendRow(row);
}

function updateWord(wordData) {
  const sheet = getSheet(SHEET_NAMES.VOCAB);
  const rowIndex = findRowIndexById(sheet, wordData.id);
  
  if (rowIndex > -1) {
    const rowData = wordToRow(wordData);
    // Overwrite the specific row (rowIndex is 0-based array, Range is 1-based, so +1)
    sheet.getRange(rowIndex + 1, 1, 1, rowData.length).setValues([rowData]);
  } else {
    // If it doesn't exist, append it
    addWord(wordData);
  }
}

function deleteWord(id) {
  if (!id) return;
  const sheet = getSheet(SHEET_NAMES.VOCAB);
  const rowIndex = findRowIndexById(sheet, id);
  if (rowIndex > -1) {
    sheet.deleteRow(rowIndex + 1); // Range is 1-based
  }
}

function logRating(data) {
  const sheet = getSheet(SHEET_NAMES.LOG);
  const timestamp = new Date().toISOString();
  // Columns: Timestamp, Word, Rating, Was Correct, Hints Used, Session ID
  sheet.appendRow([
    timestamp,
    data.word || '',
    data.rating || 0,
    data.correct || false,
    data.hints || 0,
    data.sessionId || ''
  ]);
}

function logSession(data) {
  const sheet = getSheet(SHEET_NAMES.SESSIONS);
  // Columns: Session ID, Date, Total Words, Correct, Wrong, Score, Accuracy %, Duration (sec), Hints Used
  sheet.appendRow([
    data.sessionId || '',
    new Date().toISOString().split('T')[0],
    data.totalWords || 0,
    data.correct || 0,
    data.wrong || 0,
    data.score || 0,
    data.accuracy || 0,
    data.duration || 0,
    data.hintsUsed || 0
  ]);
}

function updateSettings(data) {
  const sheet = getSheet(SHEET_NAMES.SETTINGS);
  const key = data.key;
  const value = data.value;
  
  if (!key) return;
  
  const values = sheet.getDataRange().getValues();
  let found = false;
  
  for (let i = 1; i < values.length; i++) {
    if (values[i][0] === key) {
      sheet.getRange(i + 1, 2).setValue(String(value));
      found = true;
      break;
    }
  }
  
  if (!found) {
    sheet.appendRow([key, String(value)]);
  }
}

/* ============================================================
   HELPER FUNCTIONS
============================================================ */

function getSheet(name) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
    setupHeaders(sheet, name);
  }
  return sheet;
}

function findRowIndexById(sheet, id) {
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]) === String(id)) return i;
  }
  return -1;
}

function wordToRow(w) {
  // Matches the 17 columns in the specification: A to Q
  return [
    w.id || '',
    w.word || '',
    w.ipa || '',
    w.meaning || '',
    w.pos || '',
    w.definition || '',
    (w.examples && Array.isArray(w.examples)) ? w.examples.join(' | ') : (w.examples || ''),
    (w.collocations && Array.isArray(w.collocations)) ? w.collocations.join(' | ') : (w.collocations || ''),
    w.mnemonic || '',
    w.proficiency || 0,
    w.reviewCount || 0,
    w.correctCount || 0,
    w.wrongCount || 0,
    w.hintsUsed || 0,
    w.nextReview || '',
    w.dateAdded || '',
    w.lastModified || new Date().toISOString()
  ];
}

function rowToWord(r) {
  return {
    id: String(r[0]),
    word: String(r[1]),
    ipa: String(r[2]),
    meaning: String(r[3]),
    pos: String(r[4]),
    definition: String(r[5]),
    examples: r[6] ? String(r[6]).split(' | ').filter(e => e.trim()) : [],
    collocations: r[7] ? String(r[7]).split(' | ').filter(c => c.trim()) : [],
    mnemonic: String(r[8]),
    proficiency: parseInt(r[9]) || 0,
    reviewCount: parseInt(r[10]) || 0,
    correctCount: parseInt(r[11]) || 0,
    wrongCount: parseInt(r[12]) || 0,
    hintsUsed: parseInt(r[13]) || 0,
    nextReview: String(r[14]),
    dateAdded: String(r[15]),
    lastModified: String(r[16])
  };
}

function createJsonResponse(data) {
  return ContentService.createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}

function setupHeaders(sheet, name) {
  if (name === SHEET_NAMES.VOCAB) {
    sheet.appendRow(['ID', 'Word', 'IPA', 'Arabic Meaning', 'Part of Speech', 'Definition', 'Examples', 'Collocations', 'Mnemonic', 'Proficiency', 'Review Count', 'Correct Count', 'Wrong Count', 'Hints Used', 'Next Review Date', 'Date Added', 'Last Modified']);
    sheet.getRange('A1:Q1').setFontWeight('bold');
  } else if (name === SHEET_NAMES.LOG) {
    sheet.appendRow(['Timestamp', 'Word', 'Rating', 'Was Correct', 'Hints Used', 'Session ID']);
    sheet.getRange('A1:F1').setFontWeight('bold');
  } else if (name === SHEET_NAMES.SESSIONS) {
    sheet.appendRow(['Session ID', 'Date', 'Total Words', 'Correct', 'Wrong', 'Score', 'Accuracy %', 'Duration (sec)', 'Hints Used']);
    sheet.getRange('A1:I1').setFontWeight('bold');
  } else if (name === SHEET_NAMES.SETTINGS) {
    sheet.appendRow(['Key', 'Value']);
    sheet.getRange('A1:B1').setFontWeight('bold');
  }
  sheet.setFrozenRows(1);
}
